<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 
      Menggunakan Theme.AppCompat.NoActionBar agar aman di Android lama (API 21+)
      NoActionBar agar tulisan nama aplikasi di bagian atas layar hilang, 
      sehingga UI Speedometer bisa full screen.
    -->
    <style name="Theme.PcxUI" parent="Theme.AppCompat.NoActionBar">
        <!-- Warna background utama aplikasi (Hitam pekat seperti layar TFT) -->
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Warna status bar (bagian paling atas HP) -->
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
