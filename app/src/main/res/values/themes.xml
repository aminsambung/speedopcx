<?xml version="1.0" encoding="utf-8"?>
<resources>
    xmlns:tools="http://schemas.android.com/tools"> <!-- TAMBAHKAN INI -->
    <!-- 
      Kita menggunakan Theme.AppCompat.NoActionBar agar kompatibel dengan Android lama.
      NoActionBar digunakan agar tulisan "PCX Speedo" di bagian atas layar hilang, 
      sehingga UI speedometer bisa full screen.
    -->
    <style name="Theme.PcxUI" parent="Theme.AppCompat.NoActionBar">
        <!-- Warna background utama aplikasi (Hitam pekat seperti layar TFT) -->
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Warna status bar (bagian paling atas HP) -->
        <item name="android:statusBarColor">@android:color/black</item>
        
        <!-- Memastikan teks di HP yang ada notchnya tidak menutupi UI -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
